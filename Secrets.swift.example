import Foundation

enum Secrets {
    // Supabase → Settings → Data API → Project URL
    static let supabaseURL = "https://YOUR-PROJECT.supabase.co"

    // Supabase → Settings → API Keys → "Publishable key" (sb_publishable_...).
    // Sicura nell'app. NON usare la secret key (sb_secret_...).
    static let supabaseKey = "YOUR-PUBLISHABLE-KEY"

    // Clerk → API keys → "Publishable key" (pk_test_… / pk_live_…). Pubblica, ok nell'app.
    // NON usare la secret key (sk_…).
    static let clerkPublishableKey = "YOUR-CLERK-PUBLISHABLE-KEY"

    // Mixpanel → Project settings → "Project Token" (pubblico). Progetto con residenza EU.
    static let mixpanelToken = "YOUR-MIXPANEL-TOKEN"
}
